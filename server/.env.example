PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Email verification and password reset require SMTP in every environment.
# Use a provider-issued app password rather than a personal account password.
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# For Gmail, use smtp.gmail.com and a Google app password (not your normal password).

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# Gemini stays on the server. Recommended stable text model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional second provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
