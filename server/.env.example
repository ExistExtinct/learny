PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Email verification is enabled. In development, if SMTP is empty,
# Learny shows a one-time development verification link in the UI.
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# Gemini stays on the server. Recommended stable text model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional second provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
