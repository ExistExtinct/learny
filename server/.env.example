PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Managed PostgreSQL connection string (required to run the API).
# Use the provider's pooled/serverless connection URL for Vercel.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=5

# Local development skips email verification by default. Set this to true only
# after configuring SMTP credentials; password reset also requires SMTP.
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# For Gmail, use smtp.gmail.com and a Google app password (not your normal password).

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback

# Gemini stays on the server. Recommended stable text model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional second provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
